# ============================================================
#  BiliAgent 配置模板
#
#  用法：把这个文件复制一份改名为 .env，然后填入你自己的值
#        .env 已被 .gitignore 忽略，不会上传到 GitHub
# ============================================================


# ===== 硅基流动 API（必填）=====
# 注册地址：https://cloud.siliconflow.cn/
# 登录后在左侧「API 密钥」→「新建 API 密钥」，复制 sk- 开头的那串
SILICON_API_KEY=在这里填你的Key
SILICON_BASE_URL=https://api.siliconflow.cn/v1

# 生成答案用的模型（能力要求高）
SILICON_CHAT_MODEL=deepseek-ai/DeepSeek-V3.2
# 打分和问题改写用的模型（要求低，用小模型省钱）
SILICON_JUDGE_MODEL=Qwen/Qwen2.5-7B-Instruct
# 文本向量化用的模型（4096 维）
SILICON_EMBED_MODEL=Qwen/Qwen3-Embedding-8B

# 若聊天单独使用不同的密钥，在此配置；未配置则回落 SILICON_API_KEY
SILICON_CHAT_API_KEY=


# ===== 代理设置（选填）=====
# 爬取量大时可能被限流，配了代理会自动轮换出口 IP
# 不需要的话保持 false，下面两项留空即可
USE_PROXY=false
# 代理提取 API 地址（各家代理服务商会给你这样一个链接）
PROXY_EXTRACT_URL=
# 多少秒刷新一次代理 IP
PROXY_REFRESH_INTERVAL_SEC=40


# ===== B 站登录凭据（选填，但强烈建议填）=====
#
# 不填也能搜索视频和抓弹幕，但【拿不到评论】——B 站的评论接口需要登录态。
#
# 怎么获取：
#   1. 浏览器登录 https://www.bilibili.com
#   2. 按 F12 打开开发者工具
#   3. 切到「Application / 应用」标签
#   4. 左侧展开 Cookies → https://www.bilibili.com
#   5. 在右侧列表里找到下面这几项，把 Value 复制过来
#
# ⚠️ 安全提醒：这几个值等同于你的 B 站登录状态。
#    拿到它们的人可以以你的身份操作账号（发评论、改资料等）。
#    绝对不要提交到 GitHub、不要发给别人、不要贴在群里。
#    如果不慎泄露，去 B 站退出所有设备登录即可作废。
#
sessdata=
bili_jct=
buvid3=
dedeuserid=


# ===== MySQL 数据库（必填）=====
# 库不需要手动创建，第一次运行 init_db.py 会自动建表
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=你的MySQL密码
MYSQL_DATABASE=bilibili_analysis


# ===== 服务端口（选填，有默认值）=====
# 后端监听的端口，改了的话前端的 frontend/.env 也要同步改
SERVER_PORT=8300
